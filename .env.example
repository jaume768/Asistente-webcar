# Copiar a .env y rellenar
DJANGO_SECRET_KEY=cambia-esto
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://asistente.corsoft.es

# Webcar
WEBCAR_API_URL=https://lite.webcar.rent/webcar/appapi
DATOS_DIR=./datos

# --- Escritura en Webcar (camino 2, ver docs/Escritura.md) -------------------
# Interruptor MAESTRO. off = el agente solo propone, nunca ejecuta.
WEBCAR_ESCRITURA=off
# Qué rentacars pueden ejecutar (códigos separados por coma). Vacío = ninguno.
WEBCAR_ESCRITURA_RENTACARS=demo
# Qué acciones se permiten (vacío = todas las implementadas).
WEBCAR_ESCRITURA_ACCIONES=anular_reserva

# LLM (OpenAI o compatible)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=
# Los gpt-6 solo aceptan herramientas en chat completions con «none»
# OPENAI_REASONING_EFFORT=none
AGENTE_MAX_PASOS=15
AGENTE_MAX_FILAS=200

# Base de datos (por defecto SQLite)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=asistente
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=3306
